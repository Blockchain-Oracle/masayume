# Every variable is optional: with none of them set, the app boots against Somnia Shannon from baked defaults.

# Chain port (defaults: Shannon 50312, the dev indexer, both public WebSocket + HTTP RPCs, the live venue).
# NEXT_PUBLIC_CHAIN_ID=50312
# NEXT_PUBLIC_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
# NEXT_PUBLIC_RPC_WS_URLS=wss://api.infra.testnet.somnia.network/ws,wss://dream-rpc.somnia.network/ws
# NEXT_PUBLIC_RPC_HTTP_URLS=https://api.infra.testnet.somnia.network,https://dream-rpc.somnia.network
# NEXT_PUBLIC_VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c
# NEXT_PUBLIC_PRICE_FEED_URL=
# NEXT_PUBLIC_PRICE_FEED_QUOTE=USDC

# Wallets: browser (injected) wallets always work. Set a WalletConnect Cloud project id to add mobile/QR wallets.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Absolute origin used in share links and OG images.
# NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# ── Sensei's brain ────────────────────────────────────────────────────────────
# Provider-agnostic, through the Vercel AI SDK: the model is configuration, not code.
# All of it is server-side — never NEXT_PUBLIC_, or the credential ships to the browser.
# With none of it set the whole dock still works (ring, teaser, drawer, meter, tape,
# trade cards); only the reply is unavailable, and it names what is missing.
#
# Which model answers. Default: anthropic/claude-opus-5
# AI_MODEL=anthropic/claude-opus-5
# AI_MODEL=openai/gpt-5.4
# AI_MODEL=google/gemini-3-5-flash
#
# Then ONE of the following three, whichever you have:
#
# 1. The named provider's own key — tried first, so a key you already hold works
#    without a gateway account.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
#
# 2. Vercel AI Gateway — one key, every provider; AI_MODEL picks between them.
# AI_GATEWAY_API_KEY=
#
# 3. Any OpenAI-compatible endpoint (OpenRouter, Together, Groq, vLLM, local Ollama).
#    Takes precedence over both of the above; AI_MODEL is passed through whole.
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama

# The Room's social store — Postgres (Neon in production, any Postgres locally).
# Server-side only. Without it the Room still opens and says it isn't connected on
# this deployment; nothing else on the page depends on it. Chain truth is never
# stored here. The schema applies itself on first use.
# DATABASE_URL=

# Signs the Room's short-lived session tokens. Optional: without it a random key is
# generated per process, which is correct but asks the wallet to sign again after a
# restart or across instances. Set it in any deployment with more than one.
# ROOM_TOKEN_SECRET=

# ---- Stage 4: the EventVault (Trading Balance) ----
# Production reads contracts/deployments via the generated addresses module; these are local-fork overrides only.
# NEXT_PUBLIC_EVENT_VAULT_ADDRESS=
# NEXT_PUBLIC_FORWARDER_ADDRESS=
# NEXT_PUBLIC_EVENT_VAULT_FROM_BLOCK=

# Gas sponsorship (server only). Without SPONSOR_PRIVATE_KEY the tap key pays its own gas and the app says so.
# SPONSOR_PRIVATE_KEY=
# SPONSOR_RPC_URL=
# SPONSOR_PER_ADDRESS_PER_HOUR=30
# SPONSOR_PER_DEVICE_PER_HOUR=60
# SPONSOR_MAX_GAS=

# The X rail (server only). Without X_CLIENT_ID + X_SESSION_SECRET the routes answer { configured: false } and name what is missing.
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI=
# X_SESSION_SECRET=
# X_EXECUTOR_ADDRESS=            # or NEXT_PUBLIC_X_EXECUTOR_ADDRESS — the address the EXECUTOR grant names
# Ops (services/ops): X_BEARER_TOKEN, X_ACCOUNT_ID, X_EXECUTOR_PRIVATE_KEY, X_POSTING_ENABLED, X_USER_ACCESS_TOKEN, X_POLL_MS
